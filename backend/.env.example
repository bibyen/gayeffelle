# Copy this file to `.env` (same directory) and edit the values to point the
# backend at your own database. `.env` is git-ignored, so your local changes
# stay out of version control.
#
#   cd backend
#   cp .env.example .env
#
# Anything you leave unset falls back to the local `supabase start` defaults
# defined in src/main/resources/application.properties.

# Full JDBC URL of your Postgres database.
DATASOURCE_URL=jdbc:postgresql://localhost:54322/postgres

# Database user and password.
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres
